{
  "name": "@weblift/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebLift analysis engine, rule engine, migration engine and REST API",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "express": "^4.21.2",
    "parse5": "^7.2.1",
    "postcss": "^8.4.49"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
